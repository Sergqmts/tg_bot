# Required
DATABASE_URL=postgresql+psycopg://user:pass@localhost/vibe
SECRET_KEY=generate-with-python3-c-import-secrets-print-secrets.token_hex-32

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# WebRTC TURN (Metered)
METERED_APP_NAME=your_app_name
METERED_API_KEY=your_api_key

# SMS (верификация телефона)
# SMS_PROVIDER=log        — только лог (dev/staging, отправки нет)
# SMS_PROVIDER=smsru      — реальная отправка через sms.ru
SMS_PROVIDER=log
SMSRU_API_ID=your_smsru_api_id

# Freesound
FREESOUND_API_KEY=your_api_key

# Editor service
EDITOR_SERVICE_URL=https://editor.example.com
EDITOR_SERVICE_TOKEN=generate-strong-random-token
EDITOR_JWT_SECRET=generate-strong-random-secret

# Mail
MAIL_SENDER=noreply@example.com
MAIL_PASSWORD=your_mail_password

# WebSocket / CORS (set to your production domain)
ALLOWED_ORIGIN=https://yourdomain.com

# Bots
NEWS_BOT_TOKEN=your_telegram_bot_token

# GitHub Webhooks
GITHUB_WEBHOOK_SECRET=your_webhook_secret
